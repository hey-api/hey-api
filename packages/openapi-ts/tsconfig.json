{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src",
    "tsdown.config.ts",
    "tsdown.exe.config.ts",
    "tsdown-utils.ts",
    "vitest.setup.ts",
    "package.json"
  ],
  "exclude": ["src/ts-compiler/__snapshots__"],
  "references": [
    { "path": "../codegen-cli" },
    { "path": "../codegen-core" },
    { "path": "../json-schema-ref-parser" },
    { "path": "../shared" },
    { "path": "../types" }
  ]
}
